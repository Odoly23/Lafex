# Salin ke .env lalu isi (atau export di lingkungan server). Jangan commit .env.
SECRET_KEY=ganti-dengan-string-acak-panjang
DEBUG=0
ALLOWED_HOSTS=lafex.example.com
CSRF_TRUSTED_ORIGINS=https://lafex.example.com

# Database (kosongkan DB_ENGINE untuk SQLite saat pengembangan)
DB_ENGINE=mysql
DB_NAME=lafex
DB_USER=lafex
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# AI. Tanpa kunci ini aplikasi jalan dalam mode demo (skrip sederhana, tanpa AI).
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5     # mis. claude-haiku-5-5 untuk menekan biaya per menit

# Email kode masuk (kosongkan EMAIL_HOST untuk mencetak ke konsol)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Lafex <no-reply@lafex.example.com>

# Nilai awal saja; setelah itu diatur admin di halaman Konfigurasaun sistema
FREE_TURNS_PER_DAY=5
PAID_TURNS_PER_DAY=150
ASSET_VERSION=1                 # naikkan saat file statis berubah agar cache PWA diperbarui
